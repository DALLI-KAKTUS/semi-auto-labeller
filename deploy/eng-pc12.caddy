# /opt/web-gateway/config/sites/eng-pc12.caddy
# Ortak gateway üzerinden ENG web (eng-pc12-edge ağı) ve Label Studio (web-gateway ağı).
eng-pc12.dalli-kaktus.tr {
    encode zstd gzip
    import security_headers
    import access_log
    request_body {
        max_size 2GB
    }
    reverse_proxy eng-pc12-web:8000
}

labelstudio.dalli-kaktus.tr {
    encode zstd gzip
    import security_headers
    import access_log
    request_body {
        max_size 2GB
    }
    # Yüklenen görüntüler değişmez (adlarında rastgele önek var): tarayıcı önbelleğe alsın.
    @upload path /data/upload/*
    header @upload {
        Cache-Control "private, max-age=2592000, immutable"
        match status 200
    }
    # Yanıtı Caddy tamponlasın; uWSGI işçisi yavaş istemciyi beklemeden serbest kalsın.
    reverse_proxy eng-pc12-labelstudio:8000 {
        response_buffers 16MB
    }
}
