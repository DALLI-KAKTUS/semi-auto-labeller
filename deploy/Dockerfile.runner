# Sunucu çalıştırıcısı: yerel çalıştırıcının aynısı, sunucunun CPU'sunda (GPU yok). İşleri web'den alır; yalnız
# yöneticinin izin verdiği kullanıcılar iş verebilir. Kaynak sınırları docker-compose.yml'de.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-runner.txt .
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
        -r requirements-runner.txt \
    && pip uninstall -y opencv-python || true \
    && pip install --no-cache-dir --no-deps --force-reinstall opencv-python-headless==5.0.0.93
COPY app ./app
COPY runner ./runner
COPY models ./models
COPY labeling_config.xml ./labeling_config.xml

RUN useradd --create-home --uid 10001 eng && mkdir -p /runner-key /app/modeller /home/eng/.cache \
    && chown eng:eng /runner-key /app/modeller /home/eng/.cache
USER eng
CMD ["python", "-W", "ignore", "-m", "runner", "--device", "cpu", "--no-browser"]
