FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt \
    && pip uninstall -y opencv-python \
    && pip install --no-cache-dir --no-deps --force-reinstall opencv-python-headless==5.0.0.93
COPY app ./app
COPY web ./web
COPY runner ./runner
COPY models ./models
COPY scripts/run_runner.sh scripts/run_runner.bat scripts/export_onnx.py ./scripts/
COPY requirements.txt ./requirements.txt
COPY labeling_config.xml ./labeling_config.xml

RUN useradd --create-home --uid 10001 eng && mkdir -p /data && chown eng:eng /data
USER eng
EXPOSE 8000
CMD ["uvicorn", "web.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
