# İki alan adının DNS A/AAAA kayıtları sunucuyu göstermeli (80 ve 443 portları açık).
ENG_DOMAIN=eng.example.com
LABEL_STUDIO_DOMAIN=labels.example.com

# `openssl rand -hex 32` ile ayrı ayrı üretin; gerçek değerleri .env dosyasında tutun.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_64_CHARACTERS
LS_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARACTERS
LS_API_KEY=CHANGE_ME_RANDOM_64_CHARACTERS

# Label Studio ilk açılış yöneticisi (web kullanıcılarından ayrı)
LS_ADMIN_EMAIL=admin@example.com
LS_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ENG web uygulamasının ilk yöneticisi
ENG_ADMIN_USERNAME=admin
ENG_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
